PORT=3000
HOST=127.0.0.1

# Local dev only: print OTP codes to the server console instead of emailing
# them, so registration works without SMTP credentials. Ignored when
# NODE_ENV=production. Leave unset/false when real credentials are configured.
OTP_DEV_MODE=true

# Option A: generic SMTP (SendGrid, Mailgun, self-hosted, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=no-reply@example.com

# Option B: Gmail OAuth2 (preferred over App Password)
# Setup: https://developers.google.com/oauthplayground
# 1. Create OAuth2 Web application credentials in Google Cloud Console
# 2. Enable Gmail API, add https://mail.google.com/ as an authorized scope
# 3. Use OAuth2 Playground (configure with your client ID/secret) to get refresh token
# GMAIL_USER=your-gmail@gmail.com
# GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret
# GMAIL_REFRESH_TOKEN=your-refresh-token

# Legacy Gmail App Password (deprecated — remove after OAuth2 is working)
# EMAIL_USER=your-gmail-address@gmail.com
# EMAIL_PASS=your-app-password

# Production: exact public HTTPS origin, no trailing slash.
# APP_ORIGIN=https://swappr.example.com
# Set a unique random secret, e.g. use openssl rand -hex 32.
# SESSION_SECRET=
# Set only behind known proxies. Comma-separated addresses or CIDRs.
# TRUST_PROXY=
# Optional persistent folder holding swappr.db and the bundled courses.db.
# SWAPPR_SQL_DIR=
# Required for node seed.js --admin-only. Unique, at least 16 characters.
# SEED_ADMIN_PASSWORD=
